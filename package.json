{
  "name": "LifeOs",
  "version": "0.1.0",
  "description": "Local-first notepad and life-tracking desktop app.",
  "author": "LifeOS",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit --project tsconfig.electron.json",
    "build:renderer": "next build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:renderer && node scripts/apply-csp.mjs && npm run build:electron",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "test:kill": "node tests/forced-kill.e2e.mjs",
    "test:block-menu": "node tests/block-menu.e2e.mjs",
    "test:perf-benchmark": "node tests/perf-benchmark.e2e.mjs",
    "test:editor-smoke": "node tests/editor-smoke.e2e.mjs",
    "test:page-header": "node tests/page-header.e2e.mjs",
    "test:perf": "node tests/perf-baseline.e2e.mjs",
    "lint": "eslint",
    "test": "npm run build:electron && node --test tests/database.test.mjs tests/pages.test.mjs tests/page-saver.test.mjs tests/window-state.test.mjs tests/attachments-cleanup.test.mjs tests/attachments.test.mjs tests/markdown-paste.test.mjs tests/slash-filter.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-details": "^3.32.0",
    "@tiptap/extension-drag-handle": "^3.32.0",
    "@tiptap/extension-drag-handle-react": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.lifeos.desktop",
    "productName": "LifeOS",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
