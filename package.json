{
  "name": "LifeOs",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit --project tsconfig.electron.json",
    "build:renderer": "next build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:renderer && node scripts/apply-csp.mjs && npm run build:electron",
    "start": "electron .",
    "package": "npm run build && electron-builder",
    "lint": "eslint",
    "test": "npm run build:electron && node --test tests/database.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.lifeos.desktop",
    "productName": "LifeOS",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
