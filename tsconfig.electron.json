{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-electron"
  },
  "include": [
    "electron/**/*.ts",
    "lib/attachment-limits.ts",
    "lib/page-saver.ts",
    "lib/markdown-paste.ts",
    "lib/slash-filter.ts",
    "lib/uuid.ts"
  ],
  "exclude": ["node_modules", "dist-electron"]
}
