{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-electron"
  },
  "include": ["electron/**/*.ts"],
  "exclude": ["node_modules", "dist-electron"]
}
